<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/subtitle_style_title"
                    style="@style/TextAppearance.AppCompat.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/subtitle_style" />

            <Button
                    android:id="@+id/subtitle_style_reset"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reset" />
        </LinearLayout>

        <org.videolan.vlc.gui.view.SubtitlePreviewView
                android:id="@+id/subtitle_style_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/subtitle_style_preview" />

        <TextView
                style="@style/TextAppearance.AppCompat.Subhead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/subtitle_position" />

        <SeekBar
                android:id="@+id/subtitle_style_position"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        <TextView
                style="@style/TextAppearance.AppCompat.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subtitle_position_hint" />

        <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

            <LinearLayout
                    android:id="@+id/subtitle_style_presets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
                style="@style/TextAppearance.AppCompat.Subhead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/subtitles_size_title" />

        <SeekBar
                android:id="@+id/subtitle_style_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="6" />

        <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/subtitle_style_bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/subtitles_bold_title" />

        <TextView
                style="@style/TextAppearance.AppCompat.Subhead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/subtitles_color" />

        <LinearLayout
                android:id="@+id/subtitle_style_text_colors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal" />

        <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/subtitle_style_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/subtitles_background_title" />

        <LinearLayout
                android:id="@+id/subtitle_style_background_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                    android:id="@+id/subtitle_style_background_colors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            <TextView
                    style="@style/TextAppearance.AppCompat.Body1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/subtitles_opacity" />

            <SeekBar
                    android:id="@+id/subtitle_style_background_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="205" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/subtitle_style_outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/subtitles_outline_title" />

        <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/subtitle_style_shadow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/subtitles_shadow_title" />

        <TextView
                style="@style/TextAppearance.AppCompat.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/subtitle_style_apply_hint" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
